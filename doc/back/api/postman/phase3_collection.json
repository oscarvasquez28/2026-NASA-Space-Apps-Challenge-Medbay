              "    pm.expect(json.historical_points).to.be.an(\"array\").and.not.empty;",
              "    pm.expect(json.event_markers).to.have.lengthOf(3);",
              "    pm.expect(json.forecast_points).to.have.lengthOf(5);",
              "    json.forecast_points.forEach(function (fp) {",
              "        pm.expect(fp.lower_ci).to.be.at.most(fp.predicted_value);",
              "        pm.expect(fp.predicted_value).to.be.at.most(fp.upper_ci);",
