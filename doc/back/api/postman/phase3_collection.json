    {
      "name": "10. Astronaut - Get 6-Zone Anatomical Body Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Body status synthesizes all 6 anatomical zones with tokens and dual-view text\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.status).to.be.oneOf([\"nominal\", \"caution\", \"critical\"]);",
              "    pm.expect(json.overall_ui_token).to.be.oneOf([\"status-nominal\", \"status-caution\", \"status-critical\"]);",
              "    pm.expect(json.high_level).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(json.technical).to.be.a(\"string\").and.not.empty;",
              "    var zones = [\"head_eyes\", \"cardiovascular_chest\", \"spine_skeletal\", \"musculoskeletal_limbs\", \"gut_microbiome\", \"skin\"];",
              "    zones.forEach(function (z) {",
              "        pm.expect(json.zones).to.have.property(z);",
              "        pm.expect(json.zones[z].status).to.be.oneOf([\"nominal\", \"caution\", \"critical\"]);",
              "        pm.expect(json.zones[z].ui_token).to.be.oneOf([\"status-nominal\", \"status-caution\", \"status-critical\"]);",
              "        pm.expect(json.zones[z].recommended_countermeasures).to.be.an(\"array\").and.not.empty;",
              "        pm.expect(json.zones[z].self_exam_steps).to.be.an(\"array\").and.not.empty;",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
