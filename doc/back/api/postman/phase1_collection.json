            {
              "key": "heart_rate_bpm",
              "value": "82.0",
              "type": "text"
            },
            {
              "key": "spo2_percent",
              "value": "97.0",
              "type": "text"
            },
            {
              "key": "core_temp_c",
              "value": "37.2",
              "type": "text"
            },
            {
              "key": "target_anatomical_zone",
              "value": "skin",
              "type": "text"
            },
            {
              "key": "symptoms",
              "value": "[\"erythema\", \"pruritic rash\"]",
              "type": "text"
            },
            {
              "key": "diagnostic_image",
              "description": "Optional: select any PNG/JPEG file in Postman to verify Pillow upload preprocessing.",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/telemetry/ingest",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "telemetry", "ingest"]
        }
      }
    },
    {
      "name": "8. Astronaut - Get 6-Zone Anatomical Body Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Contains top-level and 6-zone status tokens, high_level, and technical views\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.status).to.be.oneOf([\"nominal\", \"caution\", \"critical\"]);",
              "    pm.expect(json.high_level).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(json.technical).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(json).to.have.property(\"zones\");",
              "    var zones = [\"head_eyes\", \"cardiovascular_chest\", \"spine_skeletal\", \"musculoskeletal_limbs\", \"gut_microbiome\", \"skin\"];",
              "    zones.forEach(function (z) {",
              "        pm.expect(json.zones).to.have.property(z);",
              "        pm.expect(json.zones[z].status).to.be.oneOf([\"nominal\", \"caution\", \"critical\"]);",
              "        pm.expect(json.zones[z].ui_token).to.match(/^status-(nominal|caution|critical)$/);",
              "        pm.expect(json.zones[z].high_level).to.be.a(\"string\").and.not.empty;",
              "        pm.expect(json.zones[z].technical).to.be.a(\"string\").and.not.empty;",
              "        pm.expect(json.zones[z].self_exam_steps).to.be.an(\"array\");",
              "        pm.expect(json.zones[z].recommended_countermeasures).to.be.an(\"array\");",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/astronaut/body-status?astronaut_id={{astronautId}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "astronaut", "body-status"],
          "query": [
            {
              "key": "astronaut_id",
              "value": "{{astronautId}}"
            }
          ]
        }
      }
    },
    {
      "name": "9. Triage - Baseline Evaluate (Backward Compatibility)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Baseline triage returns legacy and standardized status/high_level/technical fields\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.triage_level).to.eql(\"NOMINAL\");",
              "    pm.expect(json.status).to.eql(\"nominal\");",
              "    pm.expect(json.high_level).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(json.technical).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(json.anomaly_flags).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"astronaut_id\": \"{{astronautId}}\",\n  \"heart_rate_bpm\": 72.0,\n  \"spo2_percent\": 98.5,\n  \"core_temp_c\": 37.0\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/triage/evaluate",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "triage", "evaluate"]
        }
      }
    }
  ]
}
