# ==============================================================================
# Backend Service Environment Template (FastAPI / AI / Triage)
# Copy to `backend/.env` when running backend standalone outside root compose.
# ==============================================================================

ENVIRONMENT=local
LOG_LEVEL=INFO
PORT=8080
UVICORN_WORKERS=1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Autonomous Triage Mode: deterministic | hybrid | ai_advisory
TRIAGE_MODE=deterministic

# Database Settings (PostgreSQL or local SQLite fallback)
POSTGRES_USER=astronaut
POSTGRES_PASSWORD=spaceapps2026
POSTGRES_DB=astronaut_triage
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://astronaut:spaceapps2026@localhost:5432/astronaut_triage

# Local Offline LLM & Embeddings (Ollama)
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=medgemma
OLLAMA_EMBED_MODEL=nomic-embed-text

# Voice Synthesis & Multi-Modal Storage
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
UPLOAD_DIR=/tmp/uploads
GCS_BUCKET_NAME=

# Local Facial Recognition (OpenCV YuNet + SFace)
FACE_MODEL_DIR=/app/models/face
FACE_MATCH_THRESHOLD=0.363


# GCP & AI Provider Settings (optional in deterministic mode)
GCP_PROJECT_ID=
GCP_REGION=us-central1
GEMINI_API_KEY=
VERTEX_AI_MODEL=gemini-2.5-flash
