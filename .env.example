# ==============================================================================
# Astronaut Health Monitoring & Autonomous Triage System
# Root Environment Template (Local Docker Compose & GCP Cloud Run)
# Copy this file to `.env` for local orchestration. Never commit `.env`.
# ==============================================================================

# --- Global Project Settings ---
PROJECT_NAME=astronaut-triage-system
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Backend Service (FastAPI / Python) ---
BACKEND_IMAGE=astronaut-triage-backend:local
BACKEND_PORT=8080
BACKEND_HOST=0.0.0.0
UVICORN_WORKERS=1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Service (Next.js App Router console) ---
FRONTEND_IMAGE=astronaut-triage-frontend:local
FRONTEND_PORT=3000
# Backend base URL exposed to browser clients via GET /api/runtime-config.
PUBLIC_API_URL=http://localhost:8080
# Frontend data provider: "mock" (deterministic simulated datasets) or
# "rest" (real backend endpoints; other features fall back to labelled mocks).
DATA_PROVIDER=rest
# Prize-wheel cadence: one spin per N consecutive check-in days (spec: 7).
# Set to 1 in dev/test to earn a spin on the first check-in of the day.
# Read by the backend service and surfaced to the frontend via runtime-config.
WHEEL_CADENCE_DAYS=7

# --- Autonomous Triage & AI Configuration ---
# Modes: deterministic (rules only), hybrid (rules + AI), ai_advisory
TRIAGE_MODE=deterministic
GEMINI_API_KEY=
VERTEX_AI_MODEL=gemini-2.5-flash

# --- Database (PostgreSQL 16 + pgvector) ---
POSTGRES_USER=astronaut
POSTGRES_PASSWORD=spaceapps2026
POSTGRES_DB=astronaut_triage
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://astronaut:spaceapps2026@db:5432/astronaut_triage

# --- Local Offline LLM & Embeddings (Ollama) ---
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=medgemma
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Voice Synthesis (ElevenLabs Primary + Local Fallback) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- File Storage & Multi-Modal Uploads ---
UPLOAD_DIR=/tmp/uploads
GCS_BUCKET_NAME=

# --- Local Facial Recognition (OpenCV YuNet + SFace) ---
FACE_MODEL_DIR=/app/models/face
FACE_MATCH_THRESHOLD=0.363


# --- Google Cloud Platform (GCP) Deployment Settings ---
GCP_PROJECT_ID=
GCP_REGION=us-central1
ARTIFACT_REGISTRY_REPO=astronaut-triage
CLOUD_RUN_BACKEND_SERVICE=astronaut-triage-backend
CLOUD_RUN_FRONTEND_SERVICE=astronaut-triage-frontend
