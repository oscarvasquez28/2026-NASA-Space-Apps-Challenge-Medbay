# ==============================================================================
# Frontend Environment Template (Next.js)
# Copy to `frontend/.env.local` for local development. Never commit real secrets.
# ==============================================================================

# Base URL of the backend API reached from the browser.
# - Local dev (backend on host): http://localhost:8080
# - In Docker Compose this is injected at runtime through the
#   /api/runtime-config route from the PUBLIC_API_URL compose variable,
#   so rebuilding the image is not required when it changes.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Comma-separated astronaut identifiers offered by the selector.
# The backend has no roster endpoint yet; these mirror the identifiers used
# in backend examples/tests (AST-01, AST-02).
NEXT_PUBLIC_ASTRONAUT_IDS=AST-01,AST-02,AST-03

# HealthDataProvider implementation: "mock" (default, deterministic curated
# datasets — full UI, everything labelled SIMULATED) or "rest" (wires
# GET /health + POST /api/v1/triage/evaluate to the real backend; features
# without a backend endpoint still resolve through the mock layer and are
# marked accordingly in the UI).
NEXT_PUBLIC_DATA_PROVIDER=mock
